        "orderByDirection": "ASC"
      }
    },
    {
      "id": "fcf0de4c-0ddd-4d26-8fa2-c98132b723ce",
      "name": "Rebuild Template B64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        620
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst rows = $input.all().map(i => i.json)\n  .sort((a, b) => Number(a.chunk_index) - Number(b.chunk_index));\n\nif (!rows.length) {\n  throw new Error('AHTR template not loaded - run the AHTR Template Loader first.');\n}\n\nlet b64 = '';\nfor (const r of rows) { b64 += String(r.content_b64 || ''); }\n\nreturn [{ json: { base64: b64 } }];\n"
      }
    },
    {
      "id": "4bcb884d-879e-4b91-8c26-e819000d4bf8",
      "name": "Template To Binary",
      "type": "n8n-nodes-base.convertToFile",
