{
  "name": "NDIA API Simulator (Mock)",
  "nodes": [
    {
      "id": "bd62566f-668f-4dee-ba98-93dba565dd12",
      "name": "Receive Payment Requests",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "ndia-mock/payment-requests",
        "responseMode": "lastNode",
        "responseData": "firstEntryJson"
      },
      "webhookId": "4cc71db4-95c8-44a4-ad7b-bdcaa693290b"
    },
    {
      "id": "e63b15d6-2bd1-42c6-bf39-3350cc9bb05b",
      "name": "Decide Claim Outcomes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst body = $input.first().json.body || {};\nconst claims = Array.isArray(body.claims) ? body.claims : [];\nconst reasons = [\n  'Participant does not have funding available for this support',\n  'Invalid support item number',\n  'Service date is outside the participant plan period',\n  'Duplicate claim detected'\n];\n\nconst results = [];\nfor (const c of claims) {\n  const num = parseInt(String(c.invoice_number || '').replace(/[^0-9]/g, ''), 10) || 0;\n  // Deterministic mock rule: every 5th invoice number is rejected\n  const rejected = num % 5 === 0;\n  results.push({\n    claim_reference: c.claim_reference,\n    payment_request_number: 'PR-' + (900000 + num),\n    status: rejected ? 'REJECTED' : 'PAID',\n    paid_amount: rejected ? 0 : (Number(c.total) || 0),\n    error_message: rejected ? reasons[num % reasons.length] : ''\n  });\n}\n\nreturn [{ json: { batch_id: body.batch_id || '', received: claims.length, results: results } }];\n"
      }
    },
    {
      "id": "4e645882-dd7d-455c-89dc-a7d6ef8c00fc",
      "name": "Sticky Note 9c82ff59",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -80
      ],
      "parameters": {
        "content": "## NDIA API Simulator (mock)\n\nPlays the role of the NDIA's payment request API for testing the API submission path. Accepts POST { batch_id, claims: [...] } and returns instant per-claim outcomes (the real-time claiming model the NDIA is rolling out). Mock rule: every 5th invoice number is rejected with a realistic reason.\n\nThis whole workflow becomes redundant the day the clinic has real NDIA Digital Partnership Office access — the submission workflow just points at the real endpoint instead.",
        "color": 3
      }
    },
    {
      "id": "b3d4863d-4dfc-43fb-9701-a0bcd9606e32",
      "name": "Serve AHTR Template",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        620
      ],
      "parameters": {
        "httpMethod": "GET",
        "path": "ahtr-template",
        "responseMode": "lastNode",
        "responseData": "firstEntryBinary",
