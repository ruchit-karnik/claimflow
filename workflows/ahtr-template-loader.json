    {
      "parameters": {
        "jsCode": "\nconst b64 = String($('Extract Base64').first().json.b64 || '');\nif (!b64) return [];\n\nconst CHUNK = 40000;\nconst out = [];\nlet idx = 0;\nfor (let i = 0; i < b64.length; i += CHUNK) {\n  out.push({ json: { name: 'SIRA-AHTR-form.pdf', chunk_index: idx, content_b64: b64.slice(i, i + CHUNK) } });\n  idx++;\n}\nreturn out;\n"
      },
      "id": "8f9a79ea-d2d0-46ec-aa7d-f736bb5b8a09",
      "name": "Split Into Chunks",
